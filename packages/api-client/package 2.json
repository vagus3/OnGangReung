{
  "name": "@shg/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "FastAPI OpenAPI 스키마에서 자동 생성된 타입 안전 API 클라이언트. src/types.ts는 수정 금지 — pnpm codegen으로 재생성",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "codegen": "openapi-typescript openapi.json -o src/types.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.4.0"
  }
}
