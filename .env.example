# =============================================================================
# .env.example — 환경변수 템플릿
#
# 사용법: scripts/setup.sh가 이 파일을 .env로 복사합니다. 값을 채워서 사용하세요.
# 규칙:
#   - 실제 값(시크릿)은 절대 이 파일에 넣지 않습니다 (.env만 gitignore됨)
#   - 브라우저 노출 변수만 NEXT_PUBLIC_ 접두사 사용
#   - 접근은 shared/config/env.ts를 통해서만 (process.env 직접 접근 금지)
# =============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=MyApp
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Database (docker-compose.yml의 로컬 Postgres 기준) ──────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
# staging/prod에서는 PgBouncer 사용 시 ?pgbouncer=true 파라미터 추가 (.ai/DATABASE.md 참조)

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-real-env

# ── API 서버 ────────────────────────────────────────────────────────────────
PORT=4000
