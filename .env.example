# =============================================================================
# .env.example — 환경변수 템플릿
#
# 사용법: scripts/setup.sh가 이 파일을 .env로 복사합니다. 값을 채워서 사용하세요.
# 규칙:
#   - 실제 값(시크릿)은 절대 이 파일에 넣지 않습니다 (.env만 gitignore됨)
#   - 브라우저 노출 변수만 NEXT_PUBLIC_ 접두사 사용
#   - 프론트 접근은 shared/config/env.ts, 백엔드 접근은 app/core/config.py를
#     통해서만 (process.env / os.environ 직접 접근 금지)
# =============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=MyApp
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Database (docker-compose.yml의 로컬 Postgres 기준) ──────────────────────
# FastAPI(SQLAlchemy async)는 asyncpg 드라이버를 사용합니다.
# Docker 없이 개발할 때는 SQLite로 대체 가능: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_dev

# ── API 서버 (FastAPI) ──────────────────────────────────────────────────────
# 콤마로 구분된 CORS 허용 오리진 목록
CORS_ORIGINS=http://localhost:3000
