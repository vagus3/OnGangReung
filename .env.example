# =============================================================================
# .env.example — 환경변수 템플릿
#
# 사용법: scripts/setup.sh가 이 파일을 .env로 복사합니다. 값을 채워서 사용하세요.
# 규칙:
#   - 실제 값(시크릿)은 절대 이 파일에 넣지 않습니다 (.env만 gitignore됨)
#   - 브라우저 노출 변수만 NEXT_PUBLIC_ 접두사 사용
#   - 프론트 접근은 shared/config/env.ts, 백엔드 접근은 app/core/config.py를
#     통해서만 (process.env / os.environ 직접 접근 금지)
# =============================================================================

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=MyApp
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Database (docker-compose.yml의 로컬 Postgres 기준) ──────────────────────
# FastAPI(SQLAlchemy async)는 asyncpg 드라이버를 사용합니다.
# Docker 없이 개발할 때는 SQLite로 대체 가능: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_dev

# ── API 서버 (FastAPI) ──────────────────────────────────────────────────────
# 콤마로 구분된 CORS 허용 오리진 목록
#
# CAUTION: 세션이 쿠키 기반이라 프론트가 요청에 credentials를 실어 보냅니다.
#          이때 CORS는 와일드카드를 허용하지 않으므로 프론트가 실제로 뜨는
#          오리진을 정확히(스킴·호스트·포트까지) 적어야 합니다. 어긋나면
#          로그인은 되는데 다음 요청이 비로그인으로 가는 증상이 납니다.
#          localhost와 127.0.0.1은 서로 다른 오리진입니다.
CORS_ORIGINS=http://localhost:3000

# ── 공공데이터포털 (data.go.kr) ─────────────────────────────────────────────
# 발급: https://www.data.go.kr 회원가입 -> 각 서비스 활용신청 -> 마이페이지에서
#       일반 인증키(Decoding) 확인. 기능별로 어떤 API가 필요한지는
#       docs/api/public-data-apis.md 참조.
#
# CAUTION: 인코딩 키가 아니라 디코딩 키를 넣습니다. 인코딩 키를 넣으면
#          이중 인코딩으로 인증에 실패합니다. 가장 흔한 첫 실패 원인입니다.
TOURAPI_SERVICE_KEY=

# ── AI 코스 생성 (Anthropic) ────────────────────────────────────────────────
# 비어 있으면 결정적 스텁이 대신 응답합니다. 키 없이도 화면과 테스트가
# 동작하며, 응답의 generated_by로 스텁인지 실물인지 구분됩니다 (ADR 009).
ANTHROPIC_API_KEY=
# 모델 변경은 코드 수정 없이 설정합니다.
ANTHROPIC_MODEL=claude-opus-5
